{
  "config": {
    "port": "8181"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.1",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "firebase --non-interactive emulators:start & wait-on --timeout 30s tcp:${npm_package_config_port}",
    "stop": "lsof -t -i tcp:${npm_package_config_port} | xargs kill -9"
  }
}
